{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["node"],

    "sourceMap": true
  },

  "include": [
    "src/**/*.ts",
    "*.ts",
    "**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}